#!/bin/bash
# build.sh - Build script for GLFW Template
# Usage: ./scripts/build.sh [debug|release]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_ROOT/@BUILD_DIR_NAME@"
OUTPUT_DIR="$PROJECT_ROOT/@OUTPUT_DIR_NAME@"

# Default build type
BUILD_TYPE="Release"

if [ -n "$1" ]; then
  case "$1" in
    debug|Debug|DEBUG)
      BUILD_TYPE="Debug"
      ;;
    release|Release|RELEASE)
      BUILD_TYPE="Release"
      ;;
    *)
      echo "Unknown build type: $1"
      echo "Usage: $0 [debug|release]"
      exit 1
      ;;
  esac
fi

echo "========================================="
echo "GLFW Template Build Script"
echo "========================================="
echo "Build Type: $BUILD_TYPE"
echo "Project Root: $PROJECT_ROOT"
echo "Build Directory: $BUILD_DIR"
echo "Output Directory: $OUTPUT_DIR"
echo "========================================="

# Create build directory if it doesn't exist
mkdir -p "$BUILD_DIR"

# Navigate to build directory
cd "$BUILD_DIR"

# Module gfx is C++20 modules, which needs two things that the macOS defaults do
# not provide: a generator with a module scanner (Ninja, not Unix Makefiles) and
# a clang that can run that scanner (Homebrew LLVM, not AppleClang). CI installs
# both, so do the same here - unless the caller already chose a compiler.
GENERATOR="${CMAKE_GENERATOR:-}"
if [ -z "$GENERATOR" ] && command -v ninja >/dev/null 2>&1; then
  GENERATOR="Ninja"
fi

CONFIGURE_ARGS=()
if [ -n "$GENERATOR" ]; then
  CONFIGURE_ARGS+=("-G" "$GENERATOR")
fi

PREV_GEN=""
PREV_CXX=""
if [ -f "CMakeCache.txt" ]; then
  PREV_GEN="$(sed -n 's/^CMAKE_GENERATOR:INTERNAL=\(.*\)$/\1/p' CMakeCache.txt | head -1)"
  PREV_CXX="$(sed -n 's/^CMAKE_CXX_COMPILER:[^=]*=\(.*\)$/\1/p' CMakeCache.txt | head -1)"
fi

if [ "$(uname)" = "Darwin" ] && [ -z "${CXX:-}" ] && command -v brew >/dev/null 2>&1; then
  LLVM_HOME="$(brew --prefix llvm 2>/dev/null || true)"
  if [ -n "$LLVM_HOME" ] && [ -x "$LLVM_HOME/bin/clang++" ]; then
    # Only take over when nothing is configured yet or the cache points at the
    # Apple toolchain; another hand-picked compiler is left alone.
    case "$PREV_CXX" in
      ""|*/usr/bin/c++|*Xcode.app*|*CommandLineTools*)
        export CC="$LLVM_HOME/bin/clang"
        export CXX="$LLVM_HOME/bin/clang++"
        ;;
    esac
  fi
fi

# A directory left over from another generator or compiler cannot be
# reconfigured in place, so start that cache over instead of failing with
# CMake's "does not match the generator used previously" error.
if [ -f "CMakeCache.txt" ]; then
  if { [ -n "$GENERATOR" ] && [ -n "$PREV_GEN" ] && [ "$PREV_GEN" != "$GENERATOR" ]; } ||
     { [ -n "${CXX:-}" ] && [ -n "$PREV_CXX" ] && [ "$PREV_CXX" != "$CXX" ]; }; then
    echo "Build directory was configured with '$PREV_GEN' / '$PREV_CXX'; configuring fresh."
    CONFIGURE_ARGS=("--fresh" "${CONFIGURE_ARGS[@]}")
  fi
fi

# Configure with CMake
echo "Configuring with CMake..."
cmake "${CONFIGURE_ARGS[@]}" -DCMAKE_BUILD_TYPE="$BUILD_TYPE" "$PROJECT_ROOT"

# Build
echo "Building..."
cmake --build . --config "$BUILD_TYPE"

echo "========================================="
echo "Build complete!"
echo "Run any demo with: ./scripts/run.sh <demo>   (e.g. pbr_showcase, voxel_terrain, pbr_lighting)"
echo "Artifacts land in $OUTPUT_DIR/ (hello-triangle = @TARGET_NAME@)."
echo "========================================="
