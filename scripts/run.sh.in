#!/bin/bash
# run.sh - Run a demo executable produced by this project
# Usage: ./scripts/run.sh [target]      target defaults to @TARGET_NAME@
#        e.g. ./scripts/run.sh pbr_showcase
#             ./scripts/run.sh voxel_terrain
#             ./scripts/run.sh pbr_lighting --quit-after 3
# Each demo under src/demo/<name>/ is built to output/<name>; the bare
# hello-triangle lives in @TARGET_NAME@ (from src/main.cpp).

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_ROOT/@BUILD_DIR_NAME@"
OUTPUT_DIR="$PROJECT_ROOT/@OUTPUT_DIR_NAME@"
EXECUTABLE="$OUTPUT_DIR/${1:-@TARGET_NAME@}"

echo "========================================="
echo "GLFW Template Run Script"
echo "========================================="
echo "Executable: $EXECUTABLE"
echo "========================================="

# Check if executable exists
if [ ! -f "$EXECUTABLE" ]; then
    echo "Error: Executable not found: $EXECUTABLE"
    echo "Please build the project first using: ./scripts/build.sh"
    exit 1
fi

# Run the executable; anything past the target name goes to the app itself.
echo "Running application..."
echo ""
"$EXECUTABLE" "${@:2}"
